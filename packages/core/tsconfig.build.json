{
  // Emits the .d.ts only: Vite bundles but does not generate types. Separate
  // from tsconfig.json, whose `rootDir: "."` and `test` would put them in
  // `dist/src/` instead of `dist/`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
