{
  // Only emits .d.ts; Vite builds the bundle. Extends the base, NOT the package
  // tsconfig: its source paths for the core break `rootDir` (TS6059). Here the
  // core resolves to its build, as an installer would see it.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
