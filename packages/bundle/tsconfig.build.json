{
  // Only emits .d.ts; Vite builds the bundle. Extends the base, not the package
  // tsconfig: siblings resolve to their builds, as a consumer would see them.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
