{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Same as the aliases in vite.config.ts: the packages' source, not their dist.
    "paths": {
      "@nanoplayer/core": ["../packages/core/src/index.ts"],
      "@nanoplayer/ui": ["../packages/ui/src/index.ts"],
      "@nanoplayer/plugin-captions": ["../packages/plugin-captions/src/index.ts"],
      "@nanoplayer/plugin-chapters": ["../packages/plugin-chapters/src/index.ts"],
      "@nanoplayer/plugin-pip": ["../packages/plugin-pip/src/index.ts"],
      "@nanoplayer/plugin-audio-tracks": ["../packages/plugin-audio-tracks/src/index.ts"],
      "@nanoplayer/plugin-media-session": ["../packages/plugin-media-session/src/index.ts"],
      "@nanoplayer/plugin-quality": ["../packages/plugin-quality/src/index.ts"],
      "@nanoplayer/plugin-resume": ["../packages/plugin-resume/src/index.ts"],
      "@nanoplayer/plugin-transcript": ["../packages/plugin-transcript/src/index.ts"],
      "@nanoplayer/engine-hls": ["../packages/engine-hls/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
